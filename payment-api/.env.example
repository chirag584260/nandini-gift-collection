RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key
SITE_ORIGINS=https://nandinigift.in,https://www.nandinigift.in
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_long_lived_access_token
WHATSAPP_RECIPIENT=918266814556
WHATSAPP_TEMPLATE_NAME=new_paid_order
# Approved template body needs 8 placeholders, in this order: order ID, payment ID, amount, items, customer name, mobile, address, PIN.
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0

# Optional consent-based gift enquiries. Attach a persistent disk at /var/data first.
# Use one service instance: this file store serialises writes within one process.
ENQUIRY_DATA_DIR=/var/data/enquiries
# Choose a unique random password of at least 32 characters; never put it in frontend code.
ENQUIRY_ADMIN_TOKEN=replace_with_a_unique_random_32_character_or_longer_password
